  score += report_reserve_summary(parcel, rule, value)
  score += report_reserve_detail(parcel, rule, value)
  score += report_reserve_total(parcel, rule, value)
  score += report_reserve_average(parcel, rule, value)
  score += report_reserve_maximum(parcel, rule, value)
  score += report_reserve_minimum(parcel, rule, value)
  score += report_reserve_exception(parcel, rule, value)
  score += report_reserve_section(parcel, rule, value)
  score += report_reserve_export(parcel, rule, value)
  score += report_reconcile_summary(parcel, rule, value)
  score += report_reconcile_detail(parcel, rule, value)
  score += report_reconcile_total(parcel, rule, value)
  score += report_reconcile_average(parcel, rule, value)
  score += report_reconcile_maximum(parcel, rule, value)
  score += report_reconcile_minimum(parcel, rule, value)
