  score += report_measure_export(parcel, rule, value)
  score += report_bound_summary(parcel, rule, value)
  score += report_bound_detail(parcel, rule, value)
  score += report_bound_total(parcel, rule, value)
  score += report_bound_average(parcel, rule, value)
  score += report_bound_maximum(parcel, rule, value)
  score += report_bound_minimum(parcel, rule, value)
  score += report_bound_exception(parcel, rule, value)
  score += report_bound_section(parcel, rule, value)
  score += report_bound_export(parcel, rule, value)
  score += report_classify_summary(parcel, rule, value)
  score += report_classify_detail(parcel, rule, value)
  score += report_classify_total(parcel, rule, value)
  score += report_classify_average(parcel, rule, value)
  score += report_classify_maximum(parcel, rule, value)
  score += report_classify_minimum(parcel, rule, value)
  score += report_classify_exception(parcel, rule, value)
  score += report_classify_section(parcel, rule, value)
  score += report_classify_export(parcel, rule, value)
  score += report_project_summary(parcel, rule, value)
  score += report_project_detail(parcel, rule, value)
  score += report_project_total(parcel, rule, value)
  score += report_project_average(parcel, rule, value)
  score += report_project_maximum(parcel, rule, value)
  score += report_project_minimum(parcel, rule, value)
