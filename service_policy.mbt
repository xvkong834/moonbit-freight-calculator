///|
fn service_reconcile_fragile(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let span = rule.surcharge.oversize_limit_cm +
    rule.surcharge.overweight_limit_g / 1000 +
    value.cents.abs() % 7
  (parcel.depth_cm.max(0) + span + 0) / 6
}

///|
fn service_reconcile_oversize(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let base = parcel.weight_g + rule.first_weight_limit_g + value.cents
  if base <= 0 {
    0
  } else {
    base / 2
  }
}

///|
fn service_reconcile_insured(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let size = parcel.longest_side_cm() +
    parcel.width_cm +
    parcel.height_cm +
    value.cents.abs()
  (size * 5 + rule.volumetric_divisor) / 9
}

///|
fn service_reconcile_pickup(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let rate = rule.surcharge.fuel_percent_bp +
    rule.surcharge.insurance_percent_bp +
    parcel.weight_g.abs()
  (value.cents.abs() + rate + 2) / 3
}

///|
fn service_rank_standard(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let zones = rule.zones.length() + 1 + value.cents.abs() % 5
  (parcel.volume_cm3().abs() / zones + 13) % 28
}

///|
fn service_rank_express(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let ladder = rule.additional_weight_unit_g.max(1)
  (parcel.weight_g.max(0) / ladder + value.cents.abs()) % 42
}

///|
fn service_rank_economy(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let span = rule.surcharge.oversize_limit_cm +
    rule.surcharge.overweight_limit_g / 1000 +
    value.cents.abs() % 7
  (parcel.depth_cm.max(0) + span + 6) / 4
}

///|
fn service_rank_priority(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let base = parcel.weight_g + rule.first_weight_limit_g + value.cents
  if base <= 0 {
    0
  } else {
    base / 1
  }
}

///|
fn service_rank_remote(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let size = parcel.longest_side_cm() +
    parcel.width_cm +
    parcel.height_cm +
    value.cents.abs()
  (size * 1 + rule.volumetric_divisor) / 6
}

///|
fn service_rank_fragile(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let rate = rule.surcharge.fuel_percent_bp +
    rule.surcharge.insurance_percent_bp +
    parcel.weight_g.abs()
  (value.cents.abs() + rate + 8) / 3
}

///|
fn service_rank_oversize(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let zones = rule.zones.length() + 1 + value.cents.abs() % 5
  (parcel.volume_cm3().abs() / zones + 2) % 34
}

///|
fn service_rank_insured(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let ladder = rule.additional_weight_unit_g.max(1)
  (parcel.weight_g.max(0) / ladder + value.cents.abs()) % 48
}

///|
fn service_rank_pickup(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let span = rule.surcharge.oversize_limit_cm +
    rule.surcharge.overweight_limit_g / 1000 +
    value.cents.abs() % 7
  (parcel.depth_cm.max(0) + span + 1) / 2
}

///|
pub fn service_policy_score(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let mut score = 0
  score += service_score_standard(parcel, rule, value)
  score += service_score_express(parcel, rule, value)
  score += service_score_economy(parcel, rule, value)
  score += service_score_priority(parcel, rule, value)
  score += service_score_remote(parcel, rule, value)
  score += service_score_fragile(parcel, rule, value)
  score += service_score_oversize(parcel, rule, value)
  score += service_score_insured(parcel, rule, value)
  score += service_score_pickup(parcel, rule, value)
  score += service_check_standard(parcel, rule, value)
  score += service_check_express(parcel, rule, value)
  score += service_check_economy(parcel, rule, value)
  score += service_check_priority(parcel, rule, value)
  score += service_check_remote(parcel, rule, value)
  score += service_check_fragile(parcel, rule, value)
  score += service_check_oversize(parcel, rule, value)
  score += service_check_insured(parcel, rule, value)
  score += service_check_pickup(parcel, rule, value)
  score += service_estimate_standard(parcel, rule, value)
  score += service_estimate_express(parcel, rule, value)
  score += service_estimate_economy(parcel, rule, value)
  score += service_estimate_priority(parcel, rule, value)
  score += service_estimate_remote(parcel, rule, value)
  score += service_estimate_fragile(parcel, rule, value)
  score += service_estimate_oversize(parcel, rule, value)
  score += service_estimate_insured(parcel, rule, value)
  score += service_estimate_pickup(parcel, rule, value)
  score += service_measure_standard(parcel, rule, value)
  score += service_measure_express(parcel, rule, value)
  score += service_measure_economy(parcel, rule, value)
  score += service_measure_priority(parcel, rule, value)
  score += service_measure_remote(parcel, rule, value)
  score += service_measure_fragile(parcel, rule, value)
  score += service_measure_oversize(parcel, rule, value)
  score += service_measure_insured(parcel, rule, value)
  score += service_measure_pickup(parcel, rule, value)
  score += service_bound_standard(parcel, rule, value)
  score += service_bound_express(parcel, rule, value)
  score += service_bound_economy(parcel, rule, value)
  score += service_bound_priority(parcel, rule, value)
  score += service_bound_remote(parcel, rule, value)
  score += service_bound_fragile(parcel, rule, value)
  score += service_bound_oversize(parcel, rule, value)
  score += service_bound_insured(parcel, rule, value)
  score += service_bound_pickup(parcel, rule, value)
  score += service_classify_standard(parcel, rule, value)
  score += service_classify_express(parcel, rule, value)
  score += service_classify_economy(parcel, rule, value)
  score += service_classify_priority(parcel, rule, value)
  score += service_classify_remote(parcel, rule, value)
  score += service_classify_fragile(parcel, rule, value)
  score += service_classify_oversize(parcel, rule, value)
  score += service_classify_insured(parcel, rule, value)
  score += service_classify_pickup(parcel, rule, value)
  score += service_project_standard(parcel, rule, value)
  score += service_project_express(parcel, rule, value)
  score += service_project_economy(parcel, rule, value)
  score += service_project_priority(parcel, rule, value)
  score += service_project_remote(parcel, rule, value)
  score += service_project_fragile(parcel, rule, value)
  score += service_project_oversize(parcel, rule, value)
  score += service_project_insured(parcel, rule, value)
  score += service_project_pickup(parcel, rule, value)
  score += service_reserve_standard(parcel, rule, value)
  score += service_reserve_express(parcel, rule, value)
  score += service_reserve_economy(parcel, rule, value)
  score += service_reserve_priority(parcel, rule, value)
  score += service_reserve_remote(parcel, rule, value)
  score += service_reserve_fragile(parcel, rule, value)
  score += service_reserve_oversize(parcel, rule, value)
  score += service_reserve_insured(parcel, rule, value)
  score += service_reserve_pickup(parcel, rule, value)
  score += service_reconcile_standard(parcel, rule, value)
  score += service_reconcile_express(parcel, rule, value)
  score += service_reconcile_economy(parcel, rule, value)
  score += service_reconcile_priority(parcel, rule, value)
  score += service_reconcile_remote(parcel, rule, value)
  score += service_reconcile_fragile(parcel, rule, value)
  score += service_reconcile_oversize(parcel, rule, value)
  score += service_reconcile_insured(parcel, rule, value)
  score += service_reconcile_pickup(parcel, rule, value)
  score += service_rank_standard(parcel, rule, value)
  score += service_rank_express(parcel, rule, value)
  score += service_rank_economy(parcel, rule, value)
  score += service_rank_priority(parcel, rule, value)
  score += service_rank_remote(parcel, rule, value)
  score += service_rank_fragile(parcel, rule, value)
  score += service_rank_oversize(parcel, rule, value)
  score += service_rank_insured(parcel, rule, value)
  score += service_rank_pickup(parcel, rule, value)
