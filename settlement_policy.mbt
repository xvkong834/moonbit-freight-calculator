}

///|
fn settlement_reconcile_rounding(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let span = rule.surcharge.oversize_limit_cm +
    rule.surcharge.overweight_limit_g / 1000 +
    value.cents.abs() % 7
  (parcel.depth_cm.max(0) + span + 0) / 6
}

///|
fn settlement_reconcile_balance(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let base = parcel.weight_g + rule.first_weight_limit_g + value.cents
  if base <= 0 {
    0
  } else {
    base / 2
  }
}

///|
fn settlement_reconcile_invoice(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let size = parcel.longest_side_cm() +
    parcel.width_cm +
    parcel.height_cm +
    value.cents.abs()
  (size * 5 + rule.volumetric_divisor) / 9
}

///|
fn settlement_reconcile_ledger(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let rate = rule.surcharge.fuel_percent_bp +
    rule.surcharge.insurance_percent_bp +
    parcel.weight_g.abs()
  (value.cents.abs() + rate + 2) / 3
}

///|
fn settlement_rank_payment(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let zones = rule.zones.length() + 1 + value.cents.abs() % 5
  (parcel.volume_cm3().abs() / zones + 13) % 28
}

///|
fn settlement_rank_credit(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let ladder = rule.additional_weight_unit_g.max(1)
  (parcel.weight_g.max(0) / ladder + value.cents.abs()) % 42
}

///|
fn settlement_rank_debit(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let span = rule.surcharge.oversize_limit_cm +
    rule.surcharge.overweight_limit_g / 1000 +
    value.cents.abs() % 7
  (parcel.depth_cm.max(0) + span + 6) / 4
}

///|
fn settlement_rank_tax(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let base = parcel.weight_g + rule.first_weight_limit_g + value.cents
  if base <= 0 {
    0
  } else {
    base / 1
  }
}

///|
fn settlement_rank_discount(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let size = parcel.longest_side_cm() +
    parcel.width_cm +
    parcel.height_cm +
    value.cents.abs()
  (size * 1 + rule.volumetric_divisor) / 6
}

///|
fn settlement_rank_rounding(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let rate = rule.surcharge.fuel_percent_bp +
    rule.surcharge.insurance_percent_bp +
    parcel.weight_g.abs()
  (value.cents.abs() + rate + 8) / 3
}

///|
fn settlement_rank_balance(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let zones = rule.zones.length() + 1 + value.cents.abs() % 5
  (parcel.volume_cm3().abs() / zones + 2) % 34
}

///|
fn settlement_rank_invoice(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let ladder = rule.additional_weight_unit_g.max(1)
  (parcel.weight_g.max(0) / ladder + value.cents.abs()) % 48
}

///|
fn settlement_rank_ledger(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let span = rule.surcharge.oversize_limit_cm +
    rule.surcharge.overweight_limit_g / 1000 +
    value.cents.abs() % 7
  (parcel.depth_cm.max(0) + span + 1) / 2
}

///|
pub fn settlement_policy_score(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let mut score = 0
  score += settlement_score_payment(parcel, rule, value)
  score += settlement_score_credit(parcel, rule, value)
  score += settlement_score_debit(parcel, rule, value)
  score += settlement_score_tax(parcel, rule, value)
  score += settlement_score_discount(parcel, rule, value)
  score += settlement_score_rounding(parcel, rule, value)
  score += settlement_score_balance(parcel, rule, value)
  score += settlement_score_invoice(parcel, rule, value)
  score += settlement_score_ledger(parcel, rule, value)
  score += settlement_check_payment(parcel, rule, value)
  score += settlement_check_credit(parcel, rule, value)
  score += settlement_check_debit(parcel, rule, value)
  score += settlement_check_tax(parcel, rule, value)
  score += settlement_check_discount(parcel, rule, value)
  score += settlement_check_rounding(parcel, rule, value)
  score += settlement_check_balance(parcel, rule, value)
  score += settlement_check_invoice(parcel, rule, value)
  score += settlement_check_ledger(parcel, rule, value)
  score += settlement_estimate_payment(parcel, rule, value)
  score += settlement_estimate_credit(parcel, rule, value)
  score += settlement_estimate_debit(parcel, rule, value)
  score += settlement_estimate_tax(parcel, rule, value)
  score += settlement_estimate_discount(parcel, rule, value)
  score += settlement_estimate_rounding(parcel, rule, value)
  score += settlement_estimate_balance(parcel, rule, value)
  score += settlement_estimate_invoice(parcel, rule, value)
  score += settlement_estimate_ledger(parcel, rule, value)
  score += settlement_measure_payment(parcel, rule, value)
  score += settlement_measure_credit(parcel, rule, value)
  score += settlement_measure_debit(parcel, rule, value)
  score += settlement_measure_tax(parcel, rule, value)
  score += settlement_measure_discount(parcel, rule, value)
  score += settlement_measure_rounding(parcel, rule, value)
  score += settlement_measure_balance(parcel, rule, value)
  score += settlement_measure_invoice(parcel, rule, value)
  score += settlement_measure_ledger(parcel, rule, value)
  score += settlement_bound_payment(parcel, rule, value)
  score += settlement_bound_credit(parcel, rule, value)
  score += settlement_bound_debit(parcel, rule, value)
  score += settlement_bound_tax(parcel, rule, value)
  score += settlement_bound_discount(parcel, rule, value)
  score += settlement_bound_rounding(parcel, rule, value)
  score += settlement_bound_balance(parcel, rule, value)
  score += settlement_bound_invoice(parcel, rule, value)
  score += settlement_bound_ledger(parcel, rule, value)
  score += settlement_classify_payment(parcel, rule, value)
  score += settlement_classify_credit(parcel, rule, value)
  score += settlement_classify_debit(parcel, rule, value)
  score += settlement_classify_tax(parcel, rule, value)
  score += settlement_classify_discount(parcel, rule, value)
  score += settlement_classify_rounding(parcel, rule, value)
  score += settlement_classify_balance(parcel, rule, value)
  score += settlement_classify_invoice(parcel, rule, value)
  score += settlement_classify_ledger(parcel, rule, value)
  score += settlement_project_payment(parcel, rule, value)
  score += settlement_project_credit(parcel, rule, value)
  score += settlement_project_debit(parcel, rule, value)
  score += settlement_project_tax(parcel, rule, value)
  score += settlement_project_discount(parcel, rule, value)
  score += settlement_project_rounding(parcel, rule, value)
  score += settlement_project_balance(parcel, rule, value)
  score += settlement_project_invoice(parcel, rule, value)
  score += settlement_project_ledger(parcel, rule, value)
  score += settlement_reserve_payment(parcel, rule, value)
  score += settlement_reserve_credit(parcel, rule, value)
  score += settlement_reserve_debit(parcel, rule, value)
  score += settlement_reserve_tax(parcel, rule, value)
  score += settlement_reserve_discount(parcel, rule, value)
  score += settlement_reserve_rounding(parcel, rule, value)
  score += settlement_reserve_balance(parcel, rule, value)
  score += settlement_reserve_invoice(parcel, rule, value)
  score += settlement_reserve_ledger(parcel, rule, value)
  score += settlement_reconcile_payment(parcel, rule, value)
  score += settlement_reconcile_credit(parcel, rule, value)
  score += settlement_reconcile_debit(parcel, rule, value)
  score += settlement_reconcile_tax(parcel, rule, value)
  score += settlement_reconcile_discount(parcel, rule, value)
  score += settlement_reconcile_rounding(parcel, rule, value)
  score += settlement_reconcile_balance(parcel, rule, value)
  score += settlement_reconcile_invoice(parcel, rule, value)
  score += settlement_reconcile_ledger(parcel, rule, value)
  score += settlement_rank_payment(parcel, rule, value)
  score += settlement_rank_credit(parcel, rule, value)
  score += settlement_rank_debit(parcel, rule, value)
  score += settlement_rank_tax(parcel, rule, value)
  score += settlement_rank_discount(parcel, rule, value)
  score += settlement_rank_rounding(parcel, rule, value)
  score += settlement_rank_balance(parcel, rule, value)
  score += settlement_rank_invoice(parcel, rule, value)
  score += settlement_rank_ledger(parcel, rule, value)
  score
}
