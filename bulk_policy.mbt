  score += bulk_rank_failure(parcel, rule, value)
  score += bulk_rank_success(parcel, rule, value)
  score += bulk_rank_chunk(parcel, rule, value)
  score += bulk_rank_progress(parcel, rule, value)
  score += bulk_rank_idempotency(parcel, rule, value)
