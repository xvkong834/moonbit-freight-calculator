  score += bulk_check_progress(parcel, rule, value)
  score += bulk_check_idempotency(parcel, rule, value)
  score += bulk_check_backoff(parcel, rule, value)
  score += bulk_estimate_queued(parcel, rule, value)
  score += bulk_estimate_running(parcel, rule, value)
  score += bulk_estimate_retry(parcel, rule, value)
  score += bulk_estimate_failure(parcel, rule, value)
  score += bulk_estimate_success(parcel, rule, value)
  score += bulk_estimate_chunk(parcel, rule, value)
  score += bulk_estimate_progress(parcel, rule, value)
  score += bulk_estimate_idempotency(parcel, rule, value)
  score += bulk_estimate_backoff(parcel, rule, value)
  score += bulk_measure_queued(parcel, rule, value)
  score += bulk_measure_running(parcel, rule, value)
  score += bulk_measure_retry(parcel, rule, value)
  score += bulk_measure_failure(parcel, rule, value)
  score += bulk_measure_success(parcel, rule, value)
  score += bulk_measure_chunk(parcel, rule, value)
  score += bulk_measure_progress(parcel, rule, value)
  score += bulk_measure_idempotency(parcel, rule, value)
  score += bulk_measure_backoff(parcel, rule, value)
  score += bulk_bound_queued(parcel, rule, value)
  score += bulk_bound_running(parcel, rule, value)
  score += bulk_bound_retry(parcel, rule, value)
  score += bulk_bound_failure(parcel, rule, value)
  score += bulk_bound_success(parcel, rule, value)
  score += bulk_bound_chunk(parcel, rule, value)
  score += bulk_bound_progress(parcel, rule, value)
  score += bulk_bound_idempotency(parcel, rule, value)
  score += bulk_bound_backoff(parcel, rule, value)
  score += bulk_classify_queued(parcel, rule, value)
  score += bulk_classify_running(parcel, rule, value)
  score += bulk_classify_retry(parcel, rule, value)
  score += bulk_classify_failure(parcel, rule, value)
  score += bulk_classify_success(parcel, rule, value)
  score += bulk_classify_chunk(parcel, rule, value)
  score += bulk_classify_progress(parcel, rule, value)
  score += bulk_classify_idempotency(parcel, rule, value)
  score += bulk_classify_backoff(parcel, rule, value)
  score += bulk_project_queued(parcel, rule, value)
  score += bulk_project_running(parcel, rule, value)
  score += bulk_project_retry(parcel, rule, value)
  score += bulk_project_failure(parcel, rule, value)
  score += bulk_project_success(parcel, rule, value)
  score += bulk_project_chunk(parcel, rule, value)
  score += bulk_project_progress(parcel, rule, value)
  score += bulk_project_idempotency(parcel, rule, value)
  score += bulk_project_backoff(parcel, rule, value)
  score += bulk_reserve_queued(parcel, rule, value)
  score += bulk_reserve_running(parcel, rule, value)
  score += bulk_reserve_retry(parcel, rule, value)
  score += bulk_reserve_failure(parcel, rule, value)
  score += bulk_reserve_success(parcel, rule, value)
  score += bulk_reserve_chunk(parcel, rule, value)
  score += bulk_reserve_progress(parcel, rule, value)
  score += bulk_reserve_idempotency(parcel, rule, value)
  score += bulk_reserve_backoff(parcel, rule, value)
  score += bulk_reconcile_queued(parcel, rule, value)
  score += bulk_reconcile_running(parcel, rule, value)
  score += bulk_reconcile_retry(parcel, rule, value)
  score += bulk_reconcile_failure(parcel, rule, value)
  score += bulk_reconcile_success(parcel, rule, value)
  score += bulk_reconcile_chunk(parcel, rule, value)
  score += bulk_reconcile_progress(parcel, rule, value)
  score += bulk_reconcile_idempotency(parcel, rule, value)
  score += bulk_reconcile_backoff(parcel, rule, value)
  score += bulk_rank_queued(parcel, rule, value)
  score += bulk_rank_running(parcel, rule, value)
