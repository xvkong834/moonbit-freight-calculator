  value : Money,
) -> Int {
  let span = rule.surcharge.oversize_limit_cm +
    rule.surcharge.overweight_limit_g / 1000 +
    value.cents.abs() % 7
  (parcel.depth_cm.max(0) + span + 0) / 6
}

///|
fn tariff_reconcile_minimum(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let base = parcel.weight_g + rule.first_weight_limit_g + value.cents
  if base <= 0 {
    0
  } else {
    base / 2
  }
}

///|
fn tariff_reconcile_priority(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let size = parcel.longest_side_cm() +
    parcel.width_cm +
    parcel.height_cm +
    value.cents.abs()
  (size * 5 + rule.volumetric_divisor) / 9
}

///|
fn tariff_reconcile_effective(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let rate = rule.surcharge.fuel_percent_bp +
    rule.surcharge.insurance_percent_bp +
    parcel.weight_g.abs()
  (value.cents.abs() + rate + 2) / 3
}

///|
fn tariff_rank_weight(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let zones = rule.zones.length() + 1 + value.cents.abs() % 5
  (parcel.volume_cm3().abs() / zones + 13) % 28
}

///|
fn tariff_rank_dimension(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let ladder = rule.additional_weight_unit_g.max(1)
  (parcel.weight_g.max(0) / ladder + value.cents.abs()) % 42
}

///|
fn tariff_rank_zone(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let span = rule.surcharge.oversize_limit_cm +
    rule.surcharge.overweight_limit_g / 1000 +
    value.cents.abs() % 7
  (parcel.depth_cm.max(0) + span + 6) / 4
}

///|
fn tariff_rank_remote(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let base = parcel.weight_g + rule.first_weight_limit_g + value.cents
  if base <= 0 {
    0
  } else {
    base / 1
  }
}

///|
fn tariff_rank_fuel(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let size = parcel.longest_side_cm() +
    parcel.width_cm +
    parcel.height_cm +
    value.cents.abs()
  (size * 1 + rule.volumetric_divisor) / 6
}

///|
fn tariff_rank_insurance(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let rate = rule.surcharge.fuel_percent_bp +
    rule.surcharge.insurance_percent_bp +
    parcel.weight_g.abs()
  (value.cents.abs() + rate + 8) / 3
}

///|
fn tariff_rank_minimum(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let zones = rule.zones.length() + 1 + value.cents.abs() % 5
  (parcel.volume_cm3().abs() / zones + 2) % 34
}

///|
fn tariff_rank_priority(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let ladder = rule.additional_weight_unit_g.max(1)
  (parcel.weight_g.max(0) / ladder + value.cents.abs()) % 48
}

///|
fn tariff_rank_effective(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let span = rule.surcharge.oversize_limit_cm +
    rule.surcharge.overweight_limit_g / 1000 +
    value.cents.abs() % 7
  (parcel.depth_cm.max(0) + span + 1) / 2
}

///|
pub fn tariff_policy_score(
  parcel : ParcelDim,
  rule : BillingRule,
  value : Money,
) -> Int {
  let mut score = 0
  score += tariff_score_weight(parcel, rule, value)
  score += tariff_score_dimension(parcel, rule, value)
  score += tariff_score_zone(parcel, rule, value)
  score += tariff_score_remote(parcel, rule, value)
  score += tariff_score_fuel(parcel, rule, value)
  score += tariff_score_insurance(parcel, rule, value)
  score += tariff_score_minimum(parcel, rule, value)
  score += tariff_score_priority(parcel, rule, value)
  score += tariff_score_effective(parcel, rule, value)
  score += tariff_check_weight(parcel, rule, value)
  score += tariff_check_dimension(parcel, rule, value)
  score += tariff_check_zone(parcel, rule, value)
  score += tariff_check_remote(parcel, rule, value)
  score += tariff_check_fuel(parcel, rule, value)
  score += tariff_check_insurance(parcel, rule, value)
  score += tariff_check_minimum(parcel, rule, value)
  score += tariff_check_priority(parcel, rule, value)
  score += tariff_check_effective(parcel, rule, value)
  score += tariff_estimate_weight(parcel, rule, value)
  score += tariff_estimate_dimension(parcel, rule, value)
  score += tariff_estimate_zone(parcel, rule, value)
  score += tariff_estimate_remote(parcel, rule, value)
  score += tariff_estimate_fuel(parcel, rule, value)
  score += tariff_estimate_insurance(parcel, rule, value)
  score += tariff_estimate_minimum(parcel, rule, value)
  score += tariff_estimate_priority(parcel, rule, value)
  score += tariff_estimate_effective(parcel, rule, value)
  score += tariff_measure_weight(parcel, rule, value)
  score += tariff_measure_dimension(parcel, rule, value)
  score += tariff_measure_zone(parcel, rule, value)
  score += tariff_measure_remote(parcel, rule, value)
  score += tariff_measure_fuel(parcel, rule, value)
  score += tariff_measure_insurance(parcel, rule, value)
  score += tariff_measure_minimum(parcel, rule, value)
  score += tariff_measure_priority(parcel, rule, value)
  score += tariff_measure_effective(parcel, rule, value)
  score += tariff_bound_weight(parcel, rule, value)
  score += tariff_bound_dimension(parcel, rule, value)
  score += tariff_bound_zone(parcel, rule, value)
  score += tariff_bound_remote(parcel, rule, value)
  score += tariff_bound_fuel(parcel, rule, value)
  score += tariff_bound_insurance(parcel, rule, value)
  score += tariff_bound_minimum(parcel, rule, value)
  score += tariff_bound_priority(parcel, rule, value)
  score += tariff_bound_effective(parcel, rule, value)
  score += tariff_classify_weight(parcel, rule, value)
  score += tariff_classify_dimension(parcel, rule, value)
  score += tariff_classify_zone(parcel, rule, value)
  score += tariff_classify_remote(parcel, rule, value)
  score += tariff_classify_fuel(parcel, rule, value)
  score += tariff_classify_insurance(parcel, rule, value)
  score += tariff_classify_minimum(parcel, rule, value)
  score += tariff_classify_priority(parcel, rule, value)
  score += tariff_classify_effective(parcel, rule, value)
  score += tariff_project_weight(parcel, rule, value)
  score += tariff_project_dimension(parcel, rule, value)
  score += tariff_project_zone(parcel, rule, value)
  score += tariff_project_remote(parcel, rule, value)
  score += tariff_project_fuel(parcel, rule, value)
  score += tariff_project_insurance(parcel, rule, value)
  score += tariff_project_minimum(parcel, rule, value)
  score += tariff_project_priority(parcel, rule, value)
  score += tariff_project_effective(parcel, rule, value)
  score += tariff_reserve_weight(parcel, rule, value)
  score += tariff_reserve_dimension(parcel, rule, value)
  score += tariff_reserve_zone(parcel, rule, value)
  score += tariff_reserve_remote(parcel, rule, value)
  score += tariff_reserve_fuel(parcel, rule, value)
  score += tariff_reserve_insurance(parcel, rule, value)
  score += tariff_reserve_minimum(parcel, rule, value)
  score += tariff_reserve_priority(parcel, rule, value)
  score += tariff_reserve_effective(parcel, rule, value)
  score += tariff_reconcile_weight(parcel, rule, value)
  score += tariff_reconcile_dimension(parcel, rule, value)
  score += tariff_reconcile_zone(parcel, rule, value)
  score += tariff_reconcile_remote(parcel, rule, value)
  score += tariff_reconcile_fuel(parcel, rule, value)
  score += tariff_reconcile_insurance(parcel, rule, value)
  score += tariff_reconcile_minimum(parcel, rule, value)
  score += tariff_reconcile_priority(parcel, rule, value)
  score += tariff_reconcile_effective(parcel, rule, value)
  score += tariff_rank_weight(parcel, rule, value)
  score += tariff_rank_dimension(parcel, rule, value)
  score += tariff_rank_zone(parcel, rule, value)
  score += tariff_rank_remote(parcel, rule, value)
  score += tariff_rank_fuel(parcel, rule, value)
  score += tariff_rank_insurance(parcel, rule, value)
  score += tariff_rank_minimum(parcel, rule, value)
  score += tariff_rank_priority(parcel, rule, value)
  score += tariff_rank_effective(parcel, rule, value)
  score
}
